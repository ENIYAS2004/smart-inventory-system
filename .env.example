# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# You can leave MONGODB_URI empty to automatically use the embedded zero-config MongoDB Memory Server,
# or point to your local/Atlas MongoDB instance:
# MONGODB_URI="mongodb://localhost:27017/smart_inventory"
MONGODB_URI=""

# Security & Authentication
JWT_SECRET="college_smart_inventory_jwt_secret_key_2026"

# Frontend API URL (when running standalone Vite on port 5173 and backend on port 5000)
VITE_API_URL="/api"
